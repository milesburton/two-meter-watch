{
  "name": "two-meter-watch",
  "version": "0.1.0",
  "description": "Public 2-meter amateur band (144-146MHz) monitor — waterfall, band activity, and SSTV detection (in progress). Sibling project to night-watch.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsx src/backend/cli/main.ts serve",
    "dev": "tsx --watch src/backend/cli/main.ts serve",
    "dev:ui": "cd src/frontend && npm run dev",
    "build:ui": "cd src/frontend && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npx biome check .",
    "lint:fix": "npx biome check --write .",
    "format": "npx biome format --write .",
    "typecheck": "npx tsc --noEmit",
    "status": "tsx src/backend/cli/main.ts status",
    "scan": "tsx src/backend/cli/main.ts scan",
    "serve": "tsx src/backend/cli/main.ts serve",
    "version:generate": "tsx scripts/generate-version.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "chalk": "^5.3.0",
    "fft.js": "^4.0.4",
    "ora": "^9.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.6",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
