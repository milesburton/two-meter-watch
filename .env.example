# SDR tuning range in Hz — the 2m band is 144-146MHz
SDR_FREQ_MIN=144000000
SDR_FREQ_MAX=146000000

# rtl_sdr/rtl_fm gain in dB (integer), or leave unset for auto gain
SDR_GAIN=30

# PPM frequency correction for the RTL-SDR dongle's crystal
SDR_PPM_CORRECTION=0

# Sample rate in Hz for the SDR capture
SDR_SAMPLE_RATE=2048000

# Comma-separated list of frequencies (Hz) to watch for SSTV activity (Phase 2)
SSTV_WATCH_FREQS=144500000,145500000

# Optional station location, used for display purposes only
STATION_LATITUDE=
STATION_LONGITUDE=
STATION_LABEL=

# HTTP server port
PORT=3000

# Maximum concurrent websocket connections
WS_MAX_CONNECTIONS=50

# Websocket waterfall frame broadcast rate, in Hz
WS_FRAME_RATE_HZ=5

# pino log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
